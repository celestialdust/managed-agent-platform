{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEveryGroupToFindTheOnesThisClusterOwns",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribeAutoScalingInstances",
        "autoscaling:DescribeLaunchConfigurations",
        "autoscaling:DescribeScalingActivities",
        "autoscaling:DescribeTags",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:GetInstanceTypesFromInstanceRequirements"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTheNodegroupTemplateForThisClusterOnly",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup"
      ],
      "Resource": "arn:aws:eks:us-east-1:000000000000:nodegroup/map-dev/*/*"
    },
    {
      "Sid": "ChangeCapacityOnlyInGroupsThisClusterOwns",
      "Effect": "Allow",
      "Action": [
        "autoscaling:SetDesiredCapacity",
        "autoscaling:TerminateInstanceInAutoScalingGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/k8s.io/cluster-autoscaler/map-dev": "owned"
        }
      }
    }
  ]
}
